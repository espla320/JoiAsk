{
	admin off
}

# 站点路由：被下面的域名站点和 :80 兜底站点共同复用
(joiask) {
	request_body {
		max_size 30MB
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	redir /admin /admin/

	handle /admin/* {
		uri strip_prefix /admin
		root * /work/admin
		try_files {path} {path}/ /index.html
		file_server
	}

	handle_path /upload-img/* {
		root * /work/frontend/public/upload-img
		file_server
	}

	handle {
		root * /work/frontend
		try_files {path} {path}/ /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}

# 生产域名：自动申请/续期 Let's Encrypt 证书，http 自动跳转到 https
ask.ayame.live {
	import joiask
}

# 兜底：直接访问 IP 或 localhost 时走这里（本地测试用，纯 http）
:80 {
	import joiask
}
